    {
      "name": "4. Photos",
      "item": [
        {
          "name": "Upload photo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const p = pm.response.json();",
                  "pm.test('Photo has id, title, description, Cloudinary URL, public ID and owner', () => {",
                  "  pm.expect(p).to.include.keys('_id', 'title', 'description', 'imageUrl', 'cloudinaryPublicId', 'owner', 'createdAt', 'updatedAt');",
                  "  pm.expect(p.imageUrl).to.match(/^https:\\/\\//);",
                  "  pm.expect(p.owner._id).to.eql(pm.collectionVariables.get('userId'));",
                  "});",
                  "pm.collectionVariables.set('photoId', p._id);",
                  "pm.collectionVariables.set('publicId', p.cloudinaryPublicId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/photos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "photos"
              ]
