        {
          "name": "Login - valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const payload = JSON.parse(atob(b.token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "pm.test('JWT contains user id, role and expiry', () => {",
                  "  pm.expect(payload.id).to.eql(pm.collectionVariables.get('userId'));",
                  "  pm.expect(payload.role).to.eql('user');",
                  "  pm.expect(payload.exp).to.be.above(payload.iat);",
                  "});",
                  "pm.collectionVariables.set('userToken', b.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
