      "name": "1. Auth",
      "item": [
        {
          "name": "Signup - valid",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('email', 'Sam' + Date.now() + '@Example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('Returns a JWT', () => pm.expect(b.token).to.be.a('string'));",
                  "pm.test('New account gets the user role', () => pm.expect(b.user.role).to.eql('user'));",
                  "pm.test('Email normalised to lower case', () => pm.expect(b.user.email).to.eql(pm.collectionVariables.get('email').toLowerCase()));",
                  "pm.test('Password hash is never returned', () => pm.expect(JSON.stringify(pm.response.json())).to.not.include('password'));",
                  "pm.collectionVariables.set('userToken', b.token);",
                  "pm.collectionVariables.set('userId', b.user._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "signup"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"Sam\",\n  \"email\": \"{{email}}\",\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Signup - invalid data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));"
                ]
